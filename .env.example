# .env.example
# Copy to .env and fill in. .env itself is gitignored (never commit real values).

# Local dev: SQLite, zero setup. Production: swap to a Postgres connection
# string and change `provider = "sqlite"` to `provider = "postgresql"` in
# prisma/schema.prisma - see PROJECTDOC.md section 6 (Q1) for the open
# question on which managed Postgres provider the client wants.
DATABASE_URL="file:./dev.db"
